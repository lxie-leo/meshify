{
  "name": "meshify",
  "version": "0.1.0",
  "description": "三维模型轻量化与优化工具链：simplify / segment / texture / convert / lod / optimize / inspect / doctor",
  "type": "module",
  "bin": {
    "meshify": "./bin/meshify.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "bin", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@meshify/core": "workspace:*",
    "@meshify/kernel-ts": "workspace:*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": ["3d", "gltf", "glb", "mesh", "simplify", "lod", "optimization", "agent-skills"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
