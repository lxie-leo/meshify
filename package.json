{
  "name": "meshify-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Meshify — 三维模型轻量化 Agent Skill（TS 零依赖基线 + uv 引导的 Python 增强内核）",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node fixtures/generate.mjs",
    "meshify": "node packages/cli/bin/meshify.js",
    "typecheck": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@meshify/core": "workspace:*",
    "@meshify/kernel-ts": "workspace:*",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "ndarray-pixels>sharp": "0.33.5"
    }
  }
}
